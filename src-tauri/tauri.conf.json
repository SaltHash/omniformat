{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omniformat",
  "mainBinaryName": "omniformat",
  "version": "0.1.0",
  "identifier": "studio.convert.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omniformat",
        "width": 1180,
        "height": 790,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob: asset: http://asset.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Universal file converter",
    "longDescription": "Convert images, video, audio, documents, ebooks, subtitles and archives locally on your machine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
